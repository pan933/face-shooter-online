{
  "name": "faceshooting",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.example.faceshooting",
    "productName": "FaceShooting",
    "files": [
      "main.js",
      "game/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pan933",
        "repo": "face-shooter-online",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
