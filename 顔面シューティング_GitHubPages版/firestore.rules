rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validProfile(uid) {
      return request.resource.data.keys().hasAll(['uid', 'username', 'displayName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'username', 'displayName', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_-]{2,24}$')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 96
        && request.resource.data.createdAt is timestamp;
    }

    function validScore(uid) {
      let profile = get(/databases/$(database)/documents/profiles/$(uid)).data;
      return request.resource.data.keys().hasAll(['uid', 'username', 'displayName', 'score', 'wave', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'username', 'displayName', 'score', 'wave', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.username == profile.username
        && request.resource.data.displayName == profile.displayName
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000000
        && request.resource.data.wave is int
        && request.resource.data.wave >= 1
        && request.resource.data.wave <= 999
        && request.resource.data.updatedAt == request.time;
    }

    function isPvpParticipant(roomId) {
      let roomPath = /databases/$(database)/documents/pvpRooms/$(roomId);
      return signedIn() && exists(roomPath)
        && (get(roomPath).data.hostUid == request.auth.uid
          || get(roomPath).data.guestUid == request.auth.uid);
    }

    function validPvpState(uid) {
      return request.resource.data.keys().hasAll(['uid', 'displayName', 'score', 'wave', 'hp', 'alive', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'score', 'wave', 'hp', 'alive', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 48
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000000
        && request.resource.data.wave is int
        && request.resource.data.wave >= 1
        && request.resource.data.wave <= 999
        && request.resource.data.hp is int
        && request.resource.data.hp >= 0
        && request.resource.data.hp <= 100
        && request.resource.data.alive is bool
        && request.resource.data.updatedAt == request.time;
    }

    // Private account profile: a user can create and read only their own profile.
    match /profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validProfile(uid);
      allow update, delete: if false;
    }

    // Public scores, one best-score document per authenticated user.
    match /leaderboard/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid && validScore(uid);
      allow update: if signedIn()
        && request.auth.uid == uid
        && validScore(uid)
        && (request.resource.data.score > resource.data.score
          || (request.resource.data.score == resource.data.score
            && request.resource.data.wave > resource.data.wave));
      allow delete: if false;
    }

    // Invite-code rooms for friend survival PvP. Waiting rooms can only be
    // joined once; only the two members may read their live player states.
    match /pvpRooms/{roomId} {
      // The 8-character random code is the invite. Listing rooms is always denied.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && roomId.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasAll(['hostUid', 'guestUid', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['hostUid', 'guestUid', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == ''
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.status == 'waiting'
        && resource.data.guestUid == ''
        && resource.data.hostUid != request.auth.uid
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.status == 'playing'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestUid', 'status', 'updatedAt']);
      allow delete: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && resource.data.status == 'waiting';

      match /players/{uid} {
        allow read: if isPvpParticipant(roomId);
        allow create, update: if isPvpParticipant(roomId)
          && get(/databases/$(database)/documents/pvpRooms/$(roomId)).data.status == 'playing'
          && request.auth.uid == uid
          && validPvpState(uid);
        allow delete: if false;
      }
    }
  }
}
